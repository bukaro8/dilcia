generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Moment {
  FASTING
  AFTER_LUNCH
  BEFORE_DINNER
}
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name          String?
  sessionVersion Int @default(0)
  resetTokenHash String? @unique
  resetExpiresAt DateTime?
  passwordHash String
  role         String        @default("patient")
  createdAt    DateTime      @default(now())
  measurements Measurement[]
  audits       AuditLog[]
}
model Measurement {
  id         String   @id @default(cuid())
  patientId  String
  moment     Moment
  measuredAt DateTime
  value      Decimal  @db.Decimal(5, 2)
  requestKey String?  @unique
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  patient    User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([patientId, measuredAt])
}
model GlucoseTarget {
  id         String   @id @default(cuid())
  moment     Moment   @unique
  low        Decimal? @db.Decimal(5, 2)
  high       Decimal? @db.Decimal(5, 2)
  belowIsLow Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entityId  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt])
}
